# Environment variables
# Copy this file to .env and fill in values

NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/restaurant

# CORS
CORS_ORIGIN=*

# Admin panel key (required for booking management)
ADMIN_KEY=change-me-to-a-strong-random-string

# API Keys (for production)
# YUKASSA_SHOP_ID=
# YUKASSA_SECRET_KEY=
# SMS_API_KEY=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
