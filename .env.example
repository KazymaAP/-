# ============================================================
# Nodeforge - Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your values
# NEVER commit .env with real values!

# ----- SITE -----
# Your site URL (use localhost for dev)
VITE_SITE_URL=http://localhost:5173
# Site name displayed in UI
VITE_SITE_NAME=your_site_name

# ----- TELEGRAM (Frontend only - public username) -----
# Your Telegram username (without @)
VITE_TELEGRAM_USERNAME=your_username

# ----- MINI APPS (Frontend accessible) -----
# Production Mini Apps base URL (Vite exposes VITE_* vars to frontend)
VITE_MINI_APPS_BASE_URL=https://your-miniapps.example.com
# Development Mini Apps URL (NOT exposed to frontend - no VITE_ prefix)
MINI_APPS_DEV_URL=http://localhost:3000

# ----- CONTACT (Public info) -----
VITE_CONTACT_EMAIL=your@email.com
VITE_CONTACT_PHONE=+7-999-000-00-00
VITE_CONTACT_TELEGRAM=https://t.me/your_username

# ----- SOCIAL (Public info) -----
# Open Graph image URL for social sharing
VITE_OG_IMAGE_URL=https://yoursite.com/og-image.svg
# Twitter/X username (with @)
VITE_TWITTER_USERNAME=@your_username

# ----- NOTES -----
# Backend-only variables (DATABASE_URL, REDIS_URL, API_SECRET_KEY, JWT_SECRET,
# TELEGRAM_BOT_TOKEN, TELEGRAM_WEBHOOK_URL) should be in a SEPARATE backend .env file
# NEVER put secrets in frontend .env files!
#
# Vite only exposes variables prefixed with VITE_ to the frontend.
# Variables without VITE_ prefix (like MINI_APPS_DEV_URL) are only available at build time.

# ----- BUILD INFO (Auto-populated, do not modify) -----
# VITE_APP_VERSION=1.0.0